<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="엑셀 파일을 이렇게 준비해주세요"
                android:textColor="#1F2024"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="첫 행에 열 이름을 넣으면 열 순서와 관계없이 단어를 정확하게 가져올 수 있어요."
                android:textColor="#62646B"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/excel_import_summary_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="파일 형식"
                    app:srcCompat="@drawable/ic_excel_file"
                    app:tint="#19715C" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text=".xlsx 파일 · 5MB 이하 · 최대 2,000개"
                    android:textColor="#245B4E"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="파일 미리보기"
                android:textColor="#25262A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="가로로 밀어 모든 열을 확인할 수 있어요."
                android:textColor="#85878E"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/excel_preview_outline"
                android:clipToOutline="true"
                android:fillViewport="true"
                android:scrollbars="none">

                <TableLayout
                    android:layout_width="560dp"
                    android:layout_height="wrap_content"
                    android:shrinkColumns="1"
                    android:stretchColumns="1">

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#334155">

                        <TextView
                            style="@style/ExcelPreviewHeader"
                            android:layout_width="120dp"
                            android:text="단어  *" />

                        <TextView
                            style="@style/ExcelPreviewHeader"
                            android:layout_width="170dp"
                            android:text="뜻  *" />

                        <TextView
                            style="@style/ExcelPreviewHeader"
                            android:layout_width="130dp"
                            android:text="발음" />

                        <TextView
                            style="@style/ExcelPreviewHeader"
                            android:layout_width="140dp"
                            android:text="학습 상태" />
                    </TableRow>

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF">

                        <TextView style="@style/ExcelPreviewCell" android:text="apple" />
                        <TextView style="@style/ExcelPreviewCell" android:text="사과" />
                        <TextView style="@style/ExcelPreviewCell" android:text="애플" />
                        <TextView style="@style/ExcelPreviewCell" android:text="미학습" />
                    </TableRow>

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#F7F8FA">

                        <TextView style="@style/ExcelPreviewCell" android:text="serendipity" />
                        <TextView style="@style/ExcelPreviewCell" android:text="뜻밖의 행운" />
                        <TextView style="@style/ExcelPreviewCell" android:text="세렌디피티" />
                        <TextView style="@style/ExcelPreviewCell" android:text="헷갈림" />
                    </TableRow>

                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF">

                        <TextView style="@style/ExcelPreviewCell" android:text="resilient" />
                        <TextView style="@style/ExcelPreviewCell" android:text="회복력이 강한" />
                        <TextView style="@style/ExcelPreviewCell" android:text="리질리언트" />
                        <TextView style="@style/ExcelPreviewCell" android:text="학습완료" />
                    </TableRow>
                </TableLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="열 작성 방법"
                android:textColor="#25262A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView style="@style/ExcelGuideNumber" android:text="1" />

                <TextView
                    style="@style/ExcelGuideText"
                    android:text="단어와 뜻은 필수예요. 둘 중 하나가 비어 있는 행은 가져오지 않아요." />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView style="@style/ExcelGuideNumber" android:text="2" />

                <TextView
                    style="@style/ExcelGuideText"
                    android:text="발음과 학습 상태는 선택이에요. 비워두면 발음 없음, 미학습 상태로 저장돼요." />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView style="@style/ExcelGuideNumber" android:text="3" />

                <TextView
                    style="@style/ExcelGuideText"
                    android:text="학습 상태에는 미학습, 헷갈림, 학습완료 중 하나를 입력해주세요." />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/excel_import_note_bg"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="알아두세요"
                    android:textColor="#38415A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:lineSpacingExtra="3dp"
                    android:text="• 같은 파일 안의 중복 단어는 한 번만 가져와요.\n• 단어장에 이미 있는 단어는 자동으로 건너뛰어요.\n• 여러 시트를 사용할 때는 각 시트 첫 행에 열 이름을 넣어주세요."
                    android:textColor="#626A7C"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E8E9ED" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/selectExcelFileButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:text="엑셀 파일 선택"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#3B5BDB"
        app:cornerRadius="8dp"
        app:icon="@drawable/ic_file_upload"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="#FFFFFF" />

</LinearLayout>
