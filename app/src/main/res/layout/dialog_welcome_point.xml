<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/round_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/welcomeCoinLottie"
        android:layout_width="160dp"
        android:layout_height="160dp"
        app:lottie_rawRes="@raw/coin_animation"
        app:lottie_autoPlay="true"
        app:lottie_loop="false" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="가입을 환영합니다! 🎉"
        android:textColor="#222222"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="기본 포인트 100P를 드렸어요"
        android:textColor="#3b5bdb"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="이 포인트는 AI 단어 등록에\n사용할 수 있어요."
        android:textColor="#666666"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/welcomeConfirmBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/round_background"
        android:backgroundTint="#3b5bdb"
        android:gravity="center"
        android:text="확인"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
