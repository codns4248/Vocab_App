<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/wordBookCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="#FFFDF8"
    app:cardCornerRadius="24dp"
    app:cardElevation="3dp"
    app:strokeColor="#E9E2D4"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp">

        <View
            android:id="@+id/topAccent"
            android:layout_width="0dp"
            android:layout_height="92dp"
            android:background="#F4E7C8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statusStamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:rotation="-10"
            app:cardBackgroundColor="#FFF7ED"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="#EA580C"
            app:strokeWidth="1.5dp">

            <TextView
                android:id="@+id/tvStatusStamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="3 STEP CLEAR"
                android:textAllCaps="true"
                android:textColor="#C2410C"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="MASTERED" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvBookLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="6dp"
            android:text="VOCAB BOOK"
            android:textAllCaps="true"
            android:textColor="#8C6A2E"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/topAccent"
            app:layout_constraintTop_toTopOf="@id/topAccent" />

        <TextView
            android:id="@+id/vocabularyNameTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="토익을 위한 Voca"
            android:textColor="#1F2937"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/studyModeSwitch"
            app:layout_constraintStart_toStartOf="@id/topAccent"
            app:layout_constraintTop_toBottomOf="@id/tvBookLabel"
            tools:text="토익을 위한 Voca" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/studyModeSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="학습"
            app:layout_constraintBottom_toBottomOf="@id/vocabularyNameTextView"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:text="빈출 단어를 빠르게 반복 학습하고 단계별 스탬프로 암기 진도를 확인할 수 있는 단어장"
            android:textColor="#6B7280"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topAccent"
            tools:text="빈출 단어를 빠르게 반복 학습하고 단계별 스탬프로 암기 진도를 확인할 수 있는 단어장" />

        <LinearLayout
            android:id="@+id/metaRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescription">

            <TextView
                android:id="@+id/tvWordCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FDECCE"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="120 words"
                android:textColor="#9A6700"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="120 words" />

            <TextView
                android:id="@+id/tvTodayProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="#E8F3FF"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="오늘 18개"
                android:textColor="#145DA0"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="오늘 18개" />

            <TextView
                android:id="@+id/tvUpdatedAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="04.08 수정"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                tools:text="04.08 수정" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStampTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="암기 스탬프"
            android:textColor="#374151"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/metaRow" />

        <TextView
            android:id="@+id/tvStampSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6단계 중 3단계 달성"
            android:textColor="#9CA3AF"
            android:textSize="12sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tvStampTitle"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="6단계 중 3단계 달성" />

        <LinearLayout
            android:id="@+id/stampContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvStampTitle">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="#6B7280"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/stamp1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:contentDescription="1단계 스탬프"
                    android:src="@drawable/unchecked_stamp_icon" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textColor="#6B7280"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/stamp2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:contentDescription="2단계 스탬프"
                    android:src="@drawable/unchecked_stamp_icon" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="#6B7280"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/stamp3"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:contentDescription="3단계 스탬프"
                    android:src="@drawable/unchecked_stamp_icon" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4"
                    android:textColor="#6B7280"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/stamp4"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:contentDescription="4단계 스탬프"
                    android:src="@drawable/unchecked_stamp_icon" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textColor="#6B7280"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/stamp5"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:contentDescription="5단계 스탬프"
                    android:src="@drawable/unchecked_stamp_icon" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6"
                    android:textColor="#6B7280"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/stamp6"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:contentDescription="6단계 스탬프"
                    android:src="@drawable/unchecked_stamp_icon" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_study"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="2dp"
            android:text="학습하기"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#2D6A4F"
            app:cornerRadius="18dp"
            app:iconGravity="textEnd"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
