<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. 단어장 이름 -->
        <TextView
            android:id="@+id/vocabularyNameTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="토익 필수 단어"
            android:textColor="#1A1A1A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 2. 등록된 단어 수 -->
        <TextView
            android:id="@+id/countTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="120개 단어"
            android:textColor="#888888"
            android:textSize="12sp" />

        <!-- 3. 스탬프 영역 (6단계) -->
        <LinearLayout
            android:id="@+id/stampContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- 스탬프 1 -->
            <ImageView
                android:id="@+id/stamp1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="1단계 스탬프"
                app:srcCompat="@drawable/unchecked_stamp_icon" />

            <!-- 스탬프 2 -->
            <ImageView
                android:id="@+id/stamp2"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="2단계 스탬프"
                app:srcCompat="@drawable/unchecked_stamp_icon" />

            <!-- 스탬프 3 -->
            <ImageView
                android:id="@+id/stamp3"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="3단계 스탬프"
                app:srcCompat="@drawable/unchecked_stamp_icon" />

            <!-- 스탬프 4 -->
            <ImageView
                android:id="@+id/stamp4"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="4단계 스탬프"
                app:srcCompat="@drawable/unchecked_stamp_icon" />

            <!-- 스탬프 5 -->
            <ImageView
                android:id="@+id/stamp5"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="5단계 스탬프"
                app:srcCompat="@drawable/unchecked_stamp_icon" />

            <!-- 스탬프 6 -->
            <ImageView
                android:id="@+id/stamp6"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="6단계 스탬프"
                app:srcCompat="@drawable/unchecked_stamp_icon" />
        </LinearLayout>

        <!-- 4. 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#F0F0F0" />

        <!-- 5. 하단 액션 바 (알림 정보 + 스위치) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 종 아이콘 -->
            <ImageView
                android:id="@+id/bellIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="알림 아이콘"
                app:srcCompat="@drawable/bell_alt_svgrepo_com"
                app:tint="@color/md_theme_primary" />

            <!-- 다음 복습 시간 -->
            <TextView
                android:id="@+id/nextReviewTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="다음 복습: 오늘 오후 8시"
                android:textColor="#666666"
                android:textSize="12sp" />

            <!-- 알림 스위치 (기존 ID 유지) -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/studyModeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <!-- 학습하기 버튼 (기존 그대로 유지) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btn_start_study"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/background_round_ripple"
            android:backgroundTint="@color/md_theme_primary"
            android:visibility="gone">

            <TextView
                android:id="@+id/textView12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="학습하기"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>