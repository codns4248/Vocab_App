<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp">

        <!-- ===== 헤더: 아이콘 + 단어장 정보 + 변경 버튼 ===== -->
        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp"
            android:paddingBottom="14dp">

            <!-- 단어장 아이콘 박스 -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#EEEDFE">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_agenda"
                    app:tint="#3C3489"
                    android:contentDescription="단어장" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="현재 단어장"
                    android:textSize="11sp"
                    android:textColor="#A3A3A3" />

                <TextView
                    android:id="@+id/tvCurrentBookTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Day 1 · 기초 영단어"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_media_next"
                app:tint="#737373"
                android:contentDescription="단어장 변경" />
        </LinearLayout>

        <!-- 헤더 하단 구분선 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#E5E5E5" />

        <!-- ===== 학습하기 / 공부하기 버튼 (A안: 진한 컬러 + 아웃라인) ===== -->
        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <!-- 학습 시작/중지 토글 버튼 (메인 액션, 진한 파랑 솔리드) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStudyToggle"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="#185FA5"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="학습하기"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:icon="@android:drawable/ic_media_play"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="#FFFFFF" />

            <!-- 공부하기 버튼 (학습 시간 도달 시 활성화, 아웃라인) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStudyNow"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="@android:color/transparent"
                android:enabled="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="공부하기"
                android:textColor="#A3A3A3"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:strokeColor="#E5E5E5"
                app:strokeWidth="0.5dp" />
        </LinearLayout>

        <!-- ===== 단어 리스트 + FAB ===== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="14dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewVocabulary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="12dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/vocabularyBookRegisterImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="50dp"
                android:layout_marginBottom="50dp"
                android:clickable="true"
                app:backgroundTint="#185FA5"
                app:fabSize="normal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:srcCompat="@android:drawable/ic_input_add" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>