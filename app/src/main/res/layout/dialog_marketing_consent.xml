<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp"
    android:gravity="center_horizontal"
    android:background="@drawable/round_background">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/bell_alt_svgrepo_com"
        android:tint="#3b5bdb" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="마케팅 정보를 받아보시겠어요?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#222222" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="이벤트, 할인, 새로운 기능 소식을 알려드려요.\n복습 알림과는 별개이며, 설정에서 언제든 변경할 수 있어요."
        android:textSize="14sp"
        android:textColor="#666666"
        android:lineSpacingExtra="2dp"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_marketing_deny"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="받지 않기"
            android:textColor="#444444"
            android:backgroundTint="#F0F0F4" />

        <Button
            android:id="@+id/btn_marketing_allow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="받기"
            android:textColor="#FFFFFF"
            android:backgroundTint="#3b5bdb" />
    </LinearLayout>
</LinearLayout>
