<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp"
    android:gravity="center_horizontal"
    android:background="@drawable/round_background">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/bell_alt_svgrepo_com"
        android:tint="#3b5bdb" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="복습 알림을 보내드릴게요"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#222222" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="에빙하우스의 망각곡선을 기반으로\n가장 잊어버리기 쉬운 시점에 복습 알림을 보내드려요.\n알림을 허용해야 적절한 시점에 복습할 수 있어요."
        android:textSize="14sp"
        android:textColor="#666666"
        android:lineSpacingExtra="2dp"
        android:gravity="center" />

    <Button
        android:id="@+id/btn_notification_permission_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="확인"
        android:textColor="#FFFFFF"
        android:backgroundTint="#3b5bdb" />
</LinearLayout>
