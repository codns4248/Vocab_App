<?xml version="1.0" encoding="utf-8"?>
<!-- 회원탈퇴 마지막 단계: 탈퇴 이유 설문 바텀시트.
     AccountRetentionBottomSheet(bottom_sheet_account_retention.xml) 와 같은 계열로 보이도록
     round_background / drag handle / btnClose / setFragmentResult 패턴을 그대로 따른다. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/round_background"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- drag handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bottom_sheet_handle" />

        <!-- 닫기 -->
        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="닫기"
            android:padding="2dp"
            app:srcCompat="@drawable/cancel"
            app:tint="#9AA0A6" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="6dp"
            android:lineSpacingMultiplier="1.35"
            android:text="잠깐, 떠나시는 이유를&#10;알려주시겠어요?"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="더 나은 서비스를 만드는 데 큰 도움이 돼요 (중복 선택 가능)"
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- 체크리스트. row 는 AccountWithdrawReasonBottomSheet 가 코드로 추가한다. -->
        <LinearLayout
            android:id="@+id/reasonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- 재인증 안내 배지 (provider 별 문구는 코드에서 갱신) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/withdraw_reason_badge_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="안내"
                app:srcCompat="@drawable/ic_info_small"
                app:tint="#9AA0A6" />

            <TextView
                android:id="@+id/tvReauthNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="카카오 또는 구글 계정으로 가입하셨다면, 탈퇴를 위해 재인증이 필요할 수 있어요"
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWithdraw"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="탈퇴하기"
            android:textColor="@color/withdraw_button_text"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/withdraw_button_bg_tint"
            app:cornerRadius="14dp" />

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:text="취소"
            android:textColor="#9E9E9E"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
