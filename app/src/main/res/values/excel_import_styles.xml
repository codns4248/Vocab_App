<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ExcelPreviewHeader">
        <item name="android:layout_height">44dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ExcelPreviewCell">
        <item name="android:layout_height">46dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">#3F4147</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">2</item>
    </style>

    <style name="ExcelGuideNumber">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:background">@drawable/circle_background</item>
        <item name="android:backgroundTint">#E8ECFB</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#3B5BDB</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ExcelGuideText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">#55575E</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
